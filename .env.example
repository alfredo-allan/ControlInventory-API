# Copie este arquivo pra ".env" e preencha os valores reais.
# Localmente, sem preencher nada, o app cai pra um SQLite em backend/dev.db
# (bom pra desenvolver/testar sem precisar de MySQL).

# --- Segurança ---
# Chave usada pra assinar os tokens JWT. GERE uma nova e forte em produção,
# por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-essa-chave-em-producao

# --- Banco de dados ---
# Deixe as 4 variáveis abaixo COMENTADAS/vazias pra usar SQLite (é o que o
# deploy atual usa — plano Free do PythonAnywhere, sem MySQL disponível).
# Opção A) MySQL (plano Developer do PythonAnywhere ou superior — ver
# README.md, seção 3b): preencha os 4 abaixo. No PythonAnywhere, esses
# dados aparecem na aba "Databases" do painel.
# DB_HOST=seuusuario.mysql.pythonanywhere-services.com
# DB_USER=seuusuario
# DB_PASSWORD=
# DB_NAME=seuusuario$controlinventory

# Opção B) Qualquer outro banco via URL completa do SQLAlchemy
# (se preenchida, tem prioridade menor que DB_HOST/DB_USER/... acima só se
# estes 4 não estiverem completos — ver app/config.py).
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host/nome

# --- CORS ---
# Domínios do frontend autorizados a chamar a API, separados por vírgula.
# Em dev local, "*" libera geral. Em produção, troque pelo domínio real do PWA.
CORS_ORIGINS=*

# --- Multi-tenant ---
# Slug da empresa padrão — precisa bater com EMPRESA_PADRAO em
# client/src/lib/estoqueStorage.ts no frontend.
EMPRESA_PADRAO_SLUG=frutap

# --- Ambiente ---
# "development" ou "production" (em inglês mesmo — é o literal que
# app/config.py (get_config) compara) — "production" desliga o DEBUG do Flask.
FLASK_ENV=development

# --- Frontend servido pelo mesmo Flask (produção) ---
# Pasta com o build do frontend (client/dist copiado pra cá). Deixe em
# branco/comentado em dev local (o frontend roda via `vite dev`, separado,
# na porta 5173) — só precisa existir em produção. Ver README.md, seção 3,
# passo 9.
# FRONTEND_DIST_DIR=/caminho/absoluto/pra/frontend_dist

# --- Seed inicial ---
# Senha do usuário "admin" criado por seed.py. Depois de rodar o seed uma
# vez, pode (e deve) trocar essa senha e não deixar o valor padrão em produção.
ADMIN_SEED_SENHA=troque-essa-senha
